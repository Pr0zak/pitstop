# --- database ---
POSTGRES_USER=pitstop
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pitstop

# --- image source (GHCR) ---
GHCR_OWNER=pr0zak
BACKEND_TAG=latest
FRONTEND_TAG=latest

# --- backend tokens ---
# bearer token for write/ingest endpoints
INGEST_TOKEN=replace-with-32-byte-hex
# bearer token for read endpoints
QUERY_TOKEN=replace-with-another-32-byte-hex
LOG_LEVEL=INFO
TZ=America/Chicago

# --- MQTT ---
MQTT_USER=pitstop
MQTT_PASSWORD=replace-with-random
# Bind Mosquitto to a specific LAN IP in production (set in deploy phase).
# Default 0.0.0.0 is fine for local dev.
MOSQUITTO_BIND=0.0.0.0

# --- disk monitoring (optional) ---
# Daily cron POSTs a one-liner here when rootfs > 70%.
PITSTOP_DISK_ALERT_WEBHOOK=
