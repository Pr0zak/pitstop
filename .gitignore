# Privacy-first defaults — see CLAUDE.md "Privacy" section.
# Never commit personal/private data to the public repo.

# Local data (Fuelio imports, photos, exports) — top-level only, not Kotlin packages
/data/
backend/data/
frontend/data/

# Fuelio / OBD raw exports (privacy)
*.csv
*.csv.zip
*.fuelio
fuelio-*/
# Allow synthetic test fixtures (deliberately hand-crafted, no real data).
!deploy/tests/fixtures/*.csv
!deploy/tests/fixtures/*.csv.zip

# Photos / blobs
photos/
*.jpg
*.jpeg
*.png
!frontend/src/assets/**/*.png
!frontend/src/assets/**/*.jpg
!docs/**/*.png

# Secrets / env
.env
.env.*
!.env.example
*.token
*.pem
*.key
*.crt

# Android signing
*.jks
*.keystore
keystore.properties
google-services.json

# Android Gradle build artifacts
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/local.properties
android/captures/
*.apk
*.aab

# Real (non-generic) PID profiles
pid_profiles/private-*.json
pid_profiles/*-real.json

# DB dumps / backups
*.sql.gz
*.dump
backups/

# Build / runtime
node_modules/
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
frontend/dist/
backend/dist/
*.log

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Claude Code local config (contains absolute paths, agent defs)
.claude/

# Docker volumes (if mounted at repo root accidentally)
db_data/
mosquitto_data/
mosquitto_log/
