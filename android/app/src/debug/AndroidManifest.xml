<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only additions. Merged into the main manifest for the debug
  variant only, so nothing here ships in a release build.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          Renders the real trip-detail screen against synthetic data.
          Exported so it can be launched directly for screenshots on an
          emulator with no backend configured. See the class KDoc for the
          adb line. No launcher icon, no deep link, debug variant only.
        -->
        <activity
            android:name="com.pitstop.design.TimelineGalleryActivity"
            android:exported="true"
            android:label="Trip detail preview"
            android:theme="@style/Theme.Pitstop" />
    </application>
</manifest>
