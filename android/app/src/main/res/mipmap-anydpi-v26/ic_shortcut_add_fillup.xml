<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon for the Add-Fillup launcher shortcut (#121).
  Background matches the app's launcher icon so the shortcut feels
  like a sibling tile on the home screen; foreground is the
  brand-orange fuel-pump glyph in ic_shortcut_add_fillup_foreground.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_shortcut_add_fillup_foreground" />
</adaptive-icon>
