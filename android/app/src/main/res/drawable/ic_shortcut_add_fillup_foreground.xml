<?xml version="1.0" encoding="utf-8"?>
<!--
  Foreground of the Add-Fillup launcher shortcut adaptive icon (#121).

  180° fuel-gauge dome: semicircle arc opening downward, with a red
  "low-fuel" zone at the E end, a white needle pointing into that
  zone, small E and F labels TUCKED INSIDE the bbox so they survive
  the launcher's circular mask, and a brand-accent hub.

  Layout note: E is at source x[14, 18] and F at x[46, 50] (both
  pulled inward from the arc endpoints so the letterforms survive
  the launcher's circular mask). The binding constraint is E's
  bottom-left corner (14, 50) at radius 25.46 source-units from the
  bbox centre. The Pixel launcher's mask radius is ~36 dp around
  the canvas centre, so scale 1.4 just fits:
      25.46 × 1.4 = 35.64 dp ≈ mask radius

  Source viewport 64x64, content bbox x[10, 54], y[14, 50], centre
  (32, 32). Group transform places the bbox centre near the canvas
  centre, with a 2.2 dp upward optical shift so the dome's painted
  mass (concentrated in the upper half) doesn't read as set-down
  inside the visible circle:

      translate_x = 54 - 32 * 1.4 = 9.2
      translate_y_bbox = 54 - 32 * 1.4 = 9.2
      translate_y      = 7.0  (= bbox_centred - 2.2 dp up)

  Angles below are SVG screen-space (CW from +X axis, +Y down). E
  is at 180°, top of dome at 270°, F at 0°. Needle sits at 205° —
  just past E, into the red zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:translateX="9.2"
        android:translateY="7.0"
        android:scaleX="1.4"
        android:scaleY="1.4">

        <!-- Dome arc: E (180°) over the top (270°) to F (0°) -->
        <path
            android:strokeColor="#E7E9EE"
            android:strokeAlpha="0.92"
            android:strokeWidth="3.5"
            android:strokeLineCap="butt"
            android:fillColor="#00000000"
            android:pathData="M 10 36 A 22 22 0 0 1 54 36" />

        <!-- Red low-fuel zone: 180° to 225° (~1/4 of the sweep) -->
        <path
            android:strokeColor="#FF5B3A"
            android:strokeWidth="3.5"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M 10 36 A 22 22 0 0 1 16.44 20.44" />

        <!--
          Triangular needle from hub (32, 36) to a tip at 205° on
          a radius-18 circle, landing inside the red zone:
              tip_x = 32 + 18 * cos(205°) ≈ 15.69
              tip_y = 36 + 18 * sin(205°) ≈ 28.39
          Half-width 1.5 perpendicular to the needle axis.
        -->
        <path
            android:fillColor="#E7E9EE"
            android:pathData="M 15.69 28.39 L 31.37 37.36 L 32.63 34.64 Z" />

        <!-- Hub dot, brand accent -->
        <path
            android:fillColor="#FF5B3A"
            android:pathData="M 32 36 m -2.6 0 a 2.6 2.6 0 1 0 5.2 0 a 2.6 2.6 0 1 0 -5.2 0 z" />

        <!--
          "E" label tucked inside the bbox left of the gauge centre.
          Vertical bar + three arms; 10 dp tall in source so the
          letterform survives the launcher downsample at typical
          home-screen sizes.
        -->
        <path
            android:strokeColor="#E7E9EE"
            android:strokeWidth="1.8"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M 14 40 L 14 50 M 14 40 L 18 40 M 14 45 L 17 45 M 14 50 L 18 50" />

        <!-- "F" label, mirror of E without the bottom arm -->
        <path
            android:strokeColor="#E7E9EE"
            android:strokeWidth="1.8"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M 46 40 L 46 50 M 46 40 L 50 40 M 46 45 L 49 45" />
    </group>
</vector>
