<?xml version="1.0" encoding="utf-8"?>
<!--
  Fuel pump glyph for the Add-Fillup launcher widget (#121). 24 dp
  Material-style icon: pump body on the left with a fuel-level
  indicator, a hose on the right side with the pistol grip at the
  top, and a small vertical stand line. Stroke + fill use
  @android:color/system_accent1_400 on Android 12+ (the system
  accent) so the widget honours Material You theming. On older
  releases the colorControlNormal fallback keeps the icon visible.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">

    <!-- Pump body (rounded rectangle) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M3,2 L13,2 A2,2 0 0 1 15,4 L15,20 A2,2 0 0 1 13,22 L3,22 A2,2 0 0 1 1,20 L1,4 A2,2 0 0 1 3,2 Z" />

    <!-- Window cutout showing the fuel-level gauge inside the pump -->
    <path
        android:fillColor="#000000"
        android:pathData="M3.5,5 L12.5,5 L12.5,10 L3.5,10 Z" />

    <!-- Fuel-level fill inside the window (about 60% full) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4,7 L12,7 L12,9.5 L4,9.5 Z" />

    <!-- Hose connector on the right side -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M16,7 L18,7 L18,18 A2,2 0 0 1 16,20 Z" />

    <!-- Pistol grip nozzle at the top of the hose -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M17,3 L22,3 L22,7 L20,7 L20,5 L17,5 Z" />
</vector>
