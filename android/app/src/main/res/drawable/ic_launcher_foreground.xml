<?xml version="1.0" encoding="utf-8"?>
<!--
  Pitstop launcher foreground: arc-ticks-redline-needle on Android's
  108x108 dp adaptive-icon canvas. Safe zone is the centre 66x66 dp.
  Background is the design token bg ramp (#0A0C10) declared in
  res/values/ic_launcher_background.xml.

  Geometry mirrors the web favicon at viewBox 0 0 64 64. The mark's
  visual bounding box in source coords is x [8, 56], y [9, 50] —
  visual center (32, 29.5), NOT the hub at (32, 33) because the arc
  is open at the bottom (270° sweep).

  The launcher transform centers the visual bbox horizontally and
  scales to ~98% of the 66 dp safe zone, then shifts ~3 px down to
  compensate for the U-shape's optical top-heaviness — the painted
  pixels concentrate in the upper half of the bbox, so a
  geometrically-centered placement reads as having extra space at
  the top. This is standard design practice for open-shape marks
  (logos shaped like U, V, ◢, etc).

      visual_center_after_scale = (32 * 1.35, 29.5 * 1.35) = (43.2, 39.83)
      translate_x               = 54 - 43.2 = 10.8
      translate_y_geometric     = 54 - 39.83 = 14.17
      translate_y_optical       = 14.17 + 3 = 17.17
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:translateX="10.8"
        android:translateY="17.17"
        android:scaleX="1.35"
        android:scaleY="1.35">

        <!-- Cool body arc: -135 deg to +95 deg, ink-on-bg -->
        <path
            android:strokeColor="#E7E9EE"
            android:strokeAlpha="0.92"
            android:strokeWidth="3.5"
            android:strokeLineCap="butt"
            android:fillColor="#00000000"
            android:pathData="M 15.03 50 A 24 24 0 1 1 55.86 39.04" />

        <!-- Redline segment: +95 deg to +135 deg, coral accent -->
        <path
            android:strokeColor="#FF5B3A"
            android:strokeWidth="3.5"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M 55.86 39.04 A 24 24 0 0 1 48.97 50" />

        <!-- Major ticks every 30 deg from -135 to +135. -->
        <!-- -135 -->
        <path android:strokeColor="#E7E9EE" android:strokeAlpha="0.9"
              android:strokeWidth="1.4" android:strokeLineCap="round"
              android:pathData="M 15.03 50 L 18.21 46.82" />
        <!-- -105 -->
        <path android:strokeColor="#E7E9EE" android:strokeAlpha="0.9"
              android:strokeWidth="1.4" android:strokeLineCap="round"
              android:pathData="M 13.76 38.27 L 18.13 37.10" />
        <!-- -45 -->
        <path android:strokeColor="#E7E9EE" android:strokeAlpha="0.9"
              android:strokeWidth="1.4" android:strokeLineCap="round"
              android:pathData="M 20.74 22.74 L 23.92 25.92" />
        <!-- 0 (top) -->
        <path android:strokeColor="#E7E9EE" android:strokeAlpha="0.9"
              android:strokeWidth="1.4" android:strokeLineCap="round"
              android:pathData="M 32 9 L 32 13.5" />
        <!-- +45 -->
        <path android:strokeColor="#E7E9EE" android:strokeAlpha="0.9"
              android:strokeWidth="1.4" android:strokeLineCap="round"
              android:pathData="M 43.26 22.74 L 40.08 25.92" />
        <!-- +105 (inside redline) -->
        <path android:strokeColor="#FF5B3A"
              android:strokeWidth="1.4" android:strokeLineCap="round"
              android:pathData="M 50.24 38.27 L 45.87 37.10" />
        <!-- +135 (inside redline) -->
        <path android:strokeColor="#FF5B3A"
              android:strokeWidth="1.4" android:strokeLineCap="round"
              android:pathData="M 48.97 50 L 45.79 46.82" />

        <!--
          Triangular needle from hub (32, 33) toward the redline
          boundary tick at (50.24, 38.27), tip at 80% radius.
          Coordinates match the web variant precisely so the
          launcher icon and the in-app mark are pixel-identical
          when scaled to the same size.
        -->
        <path
            android:fillColor="#E7E9EE"
            android:pathData="M 46.59 37.22 L 31.45 34.07 L 32.55 31.93 Z" />

        <!-- Hub dot — accent, slightly larger to match the needle variant -->
        <path
            android:fillColor="#FF5B3A"
            android:pathData="M 32 33 m -2.6 0 a 2.6 2.6 0 1 0 5.2 0 a 2.6 2.6 0 1 0 -5.2 0 z" />
    </group>
</vector>
