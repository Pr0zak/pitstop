<?xml version="1.0" encoding="utf-8"?>
<!--
  Pitstop launcher foreground: arc-ticks-redline logo on Android's
  108x108 dp adaptive-icon canvas. Safe zone is the centre 66x66 dp.
  Background is the flat dark surface in @color/ic_launcher_background
  (matches the frontend c-bg token, hex 101216).

  Source: frontend/public/favicon.svg (viewBox 0 0 64 64). Translated
  to 108x108 via translate(22, 22) + scale(1.0625).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:translateX="22"
        android:translateY="22"
        android:scaleX="1.0625"
        android:scaleY="1.0625">

        <!-- Main arc 180° → 45° -->
        <path
            android:strokeColor="#2F81F7"
            android:strokeWidth="4.5"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M 10 44 A 22 22 0 0 1 47.56 28.44" />

        <!-- Redline arc 45° → 0° -->
        <path
            android:strokeColor="#D29922"
            android:strokeWidth="4.5"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M 47.56 28.44 A 22 22 0 0 1 54 44" />

        <!-- 5 ticks: 3 in accent + 2 in warn -->
        <path
            android:strokeColor="#2F81F7"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:pathData="M 10 44 L 14 44" />
        <path
            android:strokeColor="#2F81F7"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:pathData="M 16.44 28.44 L 19.27 31.27" />
        <path
            android:strokeColor="#2F81F7"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:pathData="M 32 22 L 32 26" />
        <path
            android:strokeColor="#D29922"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:pathData="M 47.56 28.44 L 44.73 31.27" />
        <path
            android:strokeColor="#D29922"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:pathData="M 54 44 L 50 44" />

        <!-- Needle into the redline + tip dot + pivot dot -->
        <path
            android:strokeColor="#2F81F7"
            android:strokeWidth="3.5"
            android:strokeLineCap="round"
            android:pathData="M 32 44 L 50.5 32.7" />
        <path
            android:fillColor="#D29922"
            android:pathData="M 50.5 32.7 m -3.5 0 a 3.5 3.5 0 1 0 7 0 a 3.5 3.5 0 1 0 -7 0 z" />
        <path
            android:fillColor="#2F81F7"
            android:pathData="M 32 44 m -3.5 0 a 3.5 3.5 0 1 0 7 0 a 3.5 3.5 0 1 0 -7 0 z" />
    </group>
</vector>
