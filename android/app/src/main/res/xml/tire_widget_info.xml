<?xml version="1.0" encoding="utf-8"?>
<!-- Tire-pressure widget: 2x2 by default (FL FR / RL RR), resizable down to
     2x1 where TireWidgetProvider switches to a one-row layout. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/tire_widget"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:previewLayout="@layout/tire_widget"
    android:description="@string/tire_widget_description" />
