<?xml version="1.0" encoding="utf-8"?>
<!--
  Add-Fillup widget descriptor (#121).
  - 1x1 grid cell (Pixel: ~70dp). Non-resizable.
  - updatePeriodMillis=0 → static content, no auto-refresh.
  - targetCell{Width,Height} are the Android 12+ size hints; the
    minWidth/minHeight fallback covers older releases.
  - widgetCategory="home_screen" — not for the lock screen.
  - previewLayout uses the same RemoteViews as the live widget so
    the picker shows what you actually get.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="70dp"
    android:minHeight="70dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_add_fillup"
    android:previewLayout="@layout/widget_add_fillup"
    android:resizeMode="none"
    android:widgetCategory="home_screen"
    android:description="@string/widget_add_fillup_description" />
