<?xml version="1.0" encoding="utf-8"?>
<!-- AppWidget provider config for the fuel-level gauge widget.
     - Default 1x1 cell (minWidth=40dp, ~70dp rendered). Just the gauge —
       the subtitle is hidden at this size (no vertical room).
     - Resizable horizontally + vertically. As the user drags it bigger,
       FuelWidgetProvider reads the new dimensions in
       onAppWidgetOptionsChanged and re-shows the subtitle once there's
       at least ~1x2 of vertical space.
     - updatePeriodMillis: 30min is Android's floor for free-form updates.
       In-app refreshes call FuelWidgetProvider.refreshWidgets to update
       more frequently when the user is actively using the app. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/fuel_widget"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:previewLayout="@layout/fuel_widget"
    android:description="@string/fuel_widget_description" />
