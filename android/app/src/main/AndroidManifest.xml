<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Auto-start the bridge after a phone reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Foreground Service for the BLE+MQTT bridge -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Notifications (Android 13+) — required for the foreground service notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- In-app update flow: download the APK from GitHub Releases via
         DownloadManager and open the system package installer. The OS
         still prompts the user to grant "Install unknown apps" the first
         time it's used. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Bluetooth (Android 12+ runtime perms) -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="s" />

    <!-- Legacy Bluetooth perms for Android 11 and below -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!--
      CompanionDeviceManager (CDM) — the reliable background auto-start path.
      Associating the WiCAN as a companion device grants a STANDING exemption
      from the background-FGS-start restriction (the production
      ForegroundServiceStartNotAllowedException root cause: the app was in the
      background with no exemption when the in-car detector tried to start the
      bridge FGS). Both are install-time NORMAL permissions — no runtime
      prompt; the association dialog itself is the user's consent. Harmless
      below API 33 (the constants are recognised; the exemption simply doesn't
      apply on OS versions that lack the restriction).
        - REQUEST_COMPANION_RUN_IN_BACKGROUND: lets an associated companion
          app run in the background.
        - REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND: lets
          the associated companion app start an FGS from the background — the
          actual fix.
    -->
    <uses-permission android:name="android.permission.REQUEST_COMPANION_RUN_IN_BACKGROUND" />
    <uses-permission
        android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />

    <!-- Location: for BLE scan on legacy devices AND for GPS attached to publishes / fuel quick-add -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      Activity Recognition (Task: faster in-car detection). Opt-in 4th signal
      in InCarDetector — fires on IN_VEHICLE ENTER/EXIT transitions within
      ~5–15 s of vehicle motion, independent of WiFi handoff (which can lag
      30–60 s as the phone clings to home WiFi). Runtime permission on
      Android 10+ — we NEVER prompt at install or first launch; user opts
      in via the "Use motion detection for faster start" sub-toggle in
      Settings → Bridge service → Auto-start in car.

      Both permissions are declared: the OS one is required for API 29+,
      and the GMS one is required for API 28 and below where the system
      perm doesn't exist yet.
    -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION" />

    <!-- Camera intent for fuel receipt photos (Task #29). We do not bake bytes — URI only. -->

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <!--
      Required by CompanionDeviceManager.associate() — without this declared
      uses-feature the API throws "Must declare uses-feature
      android.software.companion_device_setup in manifest to use this API" the
      moment Pair WiCAN is tapped (the reliable background auto-start path).
      required=false so the app still installs on the rare device lacking CDM;
      the pairing UI is already gated behind presenceSupported (API 31+) and
      null-checks the system service.
    -->
    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="false" />

    <!--
      Android 11+ package visibility (Android 14 enforces it harder). The AA
      host enumerates apps that match the CarAppService action, but the
      reverse direction — pitstop's own checks against the AA host — needs
      these <queries> entries or Android filters them out. Sideloaded
      CarApp Library apps that omit this often appear in the AA dev
      "Unknown sources" list yet stay hidden from "Customise launcher".
    -->
    <queries>
        <intent>
            <action android:name="androidx.car.app.CarAppService" />
        </intent>
        <package android:name="com.google.android.projection.gearhead" />
        <package android:name="com.google.android.projection.gearhead.car" />
    </queries>

    <application
        android:name=".PitstopApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pitstop"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Pitstop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Static launcher shortcut (#121): long-press the app
                 icon to get "Add fillup", or drag it to the home
                 screen as a single-cell shortcut. The shortcut's
                 intent action is read in MainActivity.onCreate /
                 onNewIntent to land on the Fuel tab. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <service
            android:name=".service.PitstopBridgeService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|location" />

        <!--
          CompanionDeviceService — the OS binds this when an associated
          companion device (the WiCAN) is being observed via
          startObservingDevicePresence(). On API 31+ the system WAKES the app
          process and invokes onDeviceAppeared / onDeviceDisappeared when the
          WiCAN comes into / drops out of BLE range, which is how the bridge
          FGS gets started reliably from the background. The exact shape here
          matters: the system only binds a service that is exported, guarded
          by BIND_COMPANION_DEVICE_SERVICE (so only the OS can bind it), and
          declares the android.companion.CompanionDeviceService intent action.
          Present below API 31 too — it's simply never bound there (we gate
          the observe path by SDK_INT).
        -->
        <service
            android:name=".companion.WicanCompanionService"
            android:exported="true"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>

        <!--
          Android Auto / AAOS entry point. The CarAppService action filter
          and the IOT category register the app in the head-unit launcher
          (vs. NAVIGATION / COMMUNICATION categories which require special
          OEM treatment). The metadata pair declares the templated app desc
          and the minimum Car App API level — 1 covers all production
          AAP / AAOS hosts as of 2025.
        -->
        <service
            android:name=".car.PitstopCarAppService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.IOT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <receiver
            android:name=".service.BootReceiver"
            android:exported="true"
            android:enabled="true"
            android:directBootAware="false">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
            <!-- Self-update triggers MY_PACKAGE_REPLACED; we relaunch the
                 foreground bridge so updates don't silently stop it. -->
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- Handles the "Sync now" action button on the sync-reminder
             notification. Not exported — only our own app fires it
             via the PendingIntent in SyncReminderManager. -->
        <receiver
            android:name=".notif.SyncReminderReceiver"
            android:exported="false" />

        <!-- ActivityRecognitionClient transition callbacks. Fired by
             Google Play services when the device ENTERs / EXITs the
             IN_VEHICLE detected-activity state. Not exported — the
             PendingIntent we register with the AR client is implicit-by-
             component-name so only GMS in our own process can hit it. -->
        <receiver
            android:name=".presence.ActivityRecognitionReceiver"
            android:exported="false" />

        <!-- Fuel-level home-screen widget (v0.1.124). Provider draws a
             270° arc gauge to a bitmap on each onUpdate; the same code
             path also handles in-app refresh broadcasts via
             FuelWidgetProvider.refreshWidgets(). Exported so the
             launcher can bind and render it. -->
        <receiver
            android:name=".widget.FuelWidgetProvider"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fuel_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- PitstopApp implements WorkManager Configuration.Provider for
             on-demand initialization, so the default startup
             WorkManagerInitializer must be removed (else lintVitalRelease
             flags RemoveWorkManagerInitializer and the release build
             fails). Standard AndroidX recipe. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
